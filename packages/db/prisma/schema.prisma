generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id       @default(uuid())
  email         String    @unique
  username      String
  password      String

  orders        Order[]

  makerFills    Fill[]    @relation("maker")
  takerFills    Fill[]    @relation("taker")
  positions     Position[]

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Order {
  id            String            @id       @default(uuid())
  userId        String
  user          User              @relation(references: [id], fields: [userId], onDelete: Cascade)
  market        orderMarket
  price         Int
  qty           Int
  filledQty     Int
  side          orderSide
  type          orderType
  status        orderStatus

  makerFills    Fill[]          @relation("maker_order")
  takerFills    Fill[]          @relation("taker_order")
  positions     Position[]

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Fill {
  id            String         @id       @default(uuid())

  askedQty      Int
  filledQty     Int
  side          orderSide
  type          fillType
  price         Int
  asset         orderMarket

  makerId       String
  maker         User          @relation("maker", references: [id], fields: [makerId])

  takerId       String
  taker         User          @relation("taker", references: [id], fields: [takerId])

  makerOrderId  String
  makerOrder    Order         @relation("maker_order", references: [id], fields: [makerOrderId], onDelete: Cascade)

  takerOrderId  String
  takerOrder    Order         @relation("taker_order", references: [id], fields: [takerOrderId], onDelete: Cascade)

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Position {
  id              String        @id      @default(uuid())
  
  userId          String
  user            User          @relation(references: [id], fields: [userId])

  orderId         String
  order           Order         @relation(references: [id], fields: [orderId], onDelete: Cascade)

  averagePrice                Int
  isProfit                    Boolean
  liquidationPrice            Int
  margin                      Int
  market                      orderMarket
  pnl                         Int
  qty                         Int
  type                        positionType

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

enum fillType {
  MAKER
  TAKER
}

enum positionType {
  LONG
  SHORT
}

enum orderStatus {
  OPEN
  FILLED
  CANCELLED
  PARTIAL_FILLED
}

enum orderType {
  LIMIT
  MARKET
}

enum orderMarket {
  AXIS
  TATA
}

enum orderSide {
  SELL
  BUY
}
